# finance_chatbot_ui.py
"""
Personal Finance Chatbot - User Interface with emojis
Features:
- Chat interface with human-like bot replies
- Profile sidebar (income, expenses, goals)
- Budget tracker + savings progress
- Tax reminders
- Investment recommendations
- Demo bank sync (local transactions)
"""

import streamlit as st
import os
import requests
from datetime import date

# -----------------------------
# Configuration
# -----------------------------
API_BASE = os.getenv("API_BASE", "http://localhost:8000")
st.set_page_config(page_title="💬 AI Finance Chatbot", layout="wide", page_icon="💰")

# -----------------------------
# Title & Intro
# -----------------------------
st.title("💰 AI Personal Finance Assistant")
st.markdown(
    "Your *friendly finance companion* — helping you plan budgets, "
    "track savings, get tax reminders, and explore smart investments 💡."
)

# -----------------------------
# Sidebar - User Profile
# -----------------------------
with st.sidebar:
    st.header("👤 Your Profile")
    user_id = st.text_input("User ID (for demo)", value="demo_user")
    name = st.text_input("Name", value="Guest")
    monthly_income = st.number_input("Monthly income (₹)", min_value=0, step=1000, value=30000)
    monthly_expenses = st.number_input("Monthly expenses (₹)", min_value=0, step=500, value=18000)
    goal = st.text_input("Financial Goal", value="Emergency Fund")

    if st.button("💾 Save Profile"):
        st.success(f"✅ Profile updated! Hi {name} 👋")
    st.caption(f"📅 Today: {date.today().strftime('%b %d, %Y')}")
    st.markdown("---")
    st.markdown("🔒 Data is for demo only. Bank sync is simulated.")

# -----------------------------
# Session State
# -----------------------------
if "messages" not in st.session_state:
    st.session_state.messages = []  # stores (role, text)
if "transactions" not in st.session_state:
    st.session_state.transactions = []

# -----------------------------
# Layout: Chat + Tools
# -----------------------------
chat_col, tools_col = st.columns([2.5, 1.5])

# -----------------------------
# Chat Interface
# -----------------------------
with chat_col:
    st.subheader("💬 Chat with your finance guide")

    for role, msg in st.session_state.messages:
        if role == "user":
            st.markdown(f"*You:* {msg}")
        else:
            st.markdown(f"*Bot:* {msg}")

    user_message = st.text_input("Type your question here...", key="chat_input")
    send = st.button("Send")

    if send and user_message.strip():
        payload = {"user_id": user_id, "message": user_message}
        bot_text = None

        # Try backend API if available
        try:
            r = requests.post(f"{API_BASE}/chat", json=payload, timeout=6)
            if r.ok:
                bot_text = r.json().get("reply", "🤔 Sorry, I couldn't process that.")
        except Exception:
            pass

        # Fallback to local demo replies
        if not bot_text:
            m = user_message.lower()
            if "save" in m:
                savings = monthly_income - monthly_expenses
                bot_text = (
                    f"💡 You can save around ₹{savings} this month. "
                    "Try automating 20% into a recurring deposit or SIP."
                )
            elif "tax" in m:
                bot_text = (
                    "⏳ Reminder: File taxes by *31st July*. "
                    "Consider 80C-equivalent options like ELSS, PPF, or NPS."
                )
            elif "invest" in m:
                bot_text = (
                    "📈 Start small with SIPs or recurring deposits. "
                    "Diversify as your savings grow."
                )
            else:
                bot_text = (
                    "🤖 I can help with *savings, budgeting, tax reminders, and investments*. "
                    "Try asking: How much can I save?"
                )

        st.session_state.messages.append(("user", user_message))
        st.session_state.messages.append(("bot", bot_text))
        st.experimental_rerun()

    st.markdown("---")
    if st.button("🧹 Clear Chat"):
        st.session_state.messages = []
        st.success("🗑 Chat history cleared.")

    if st.button("📊 Get Recommendations"):
        try:
            r = requests.get(f"{API_BASE}/recommendations/{user_id}", timeout=6)
            if r.ok:
                recs = r.json().get("recommendations", [])
            else:
                recs = []
        except Exception:
            recs = [
                "💰 Save at least 20% of your income.",
                "✂ Cut unnecessary subscriptions.",
                "🛡 Build an emergency fund covering 3–6 months."
            ]
        st.info("💡 Recommendations:")
        for rec in recs:
            st.write("- " + rec)

# -----------------------------
# Tools Column (Budget, Tax, Bank)

with tools_col:
    st.subheader("📊 Budget & Savings")
    savings = monthly_income - monthly_expenses
    st.metric("Income 💵", f"₹{monthly_income}")
    st.metric("Expenses 💸", f"₹{monthly_expenses}")
    st.metric("Estimated Savings 💰", f"₹{savings}")

    target = st.number_input("Set monthly savings target (₹)", min_value=0, step=500, value=savings)
    if target > 0:
        progress = min(max(savings / target, 0.0), 1.0)
        st.progress(progress)
        if progress >= 1:
            st.success("🎉 Goal achieved!")
        else:
            st.info(f"You're {int(progress * 100)}% towards your goal.")

    st.markdown("---")
    st.subheader("📅 Tax Reminder")
    st.warning("⚠ File income tax returns by *31st July 2025*.")
    st.caption("Tip: Explore tax-saving investments like ELSS / PPF / NPS.")

    st.markdown("---")
    st.subheader("🏦 Bank Sync (Demo)")
    if st.button("🔗 Sync Bank Data"):
        demo_txns = [
            {"date": "2025-09-01", "amount": -1500, "desc": "Groceries"},
            {"date": "2025-09-03", "amount": -200, "desc": "Coffee"},
            {"date": "2025-09-05", "amount": 30000, "desc": "Salary"},
        ]
        st.session_state.transactions.extend(demo_txns)
        st.success("✅ Bank synced (demo data added).")

    if st.session_state.transactions:
        st.write("*Recent Transactions:*")
        for t in st.session_state.transactions[-5:]:
            st.write(f"- {t['date']}: {t['desc']} — ₹{t['amount']}")

    st.markdown("---")
    st.subheader("✨ Quick Tips")
    st.write("- Automate savings with recurring deposits.")
    st.write("- Avoid high-interest loans when possible.")
    st.write("- Review expenses monthly to stay on track.")
